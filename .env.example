# SalesSphere AI environment template

# Flask
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=salessphere
MYSQL_PASSWORD=salessphere_password
MYSQL_DB=salessphere
MYSQL_ROOT_PASSWORD=root_password

# Frontend
VITE_API_URL=/api

# Email, optional
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@salessphere.ai

# xAI Grok, optional. Empty key keeps mock AI responses enabled.
GROK_API_KEY=
